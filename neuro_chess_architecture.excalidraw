      "updated": 1,
      "link": null,
      "locked": false,
      "text": "EXTERNAL ENGINE CLIENT (externalEngine.js)\n\n\u2022 REST Client with Auto-Ping & Reconnection (/health)\n\u2022 POST /eval (Queries C++ backend asynchronously)\n\u2022 Multi-PV parsing, Best Move, Heatmap unpacking\n\u2022 Fallback trigger if backend disconnects",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 13,
      "containerId": "25104ec2-b231-4666-9892-104d1b235303",
      "originalText": "EXTERNAL ENGINE CLIENT (externalEngine.js)\n\n\u2022 REST Client with Auto-Ping & Reconnection (/health)\n\u2022 POST /eval (Queries C++ backend asynchronously)\n\u2022 Multi-PV parsing, Best Move, Heatmap unpacking\n\u2022 Fallback trigger if backend disconnects",
      "lineHeight": 1.3
    },
