    {
      "id": "62c452c4-88c9-4dbf-b520-e9c1316407cf",
      "type": "text",
      "x": 870,
      "y": 883.95,
      "width": 648.4399999999999,
      "height": 152.1,
      "angle": 0,
      "strokeColor": "#f9e2af",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1063,
      "version": 1,
      "versionNonce": 1064,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "EVALUATION ENGINE (evaluation.cpp / evaluation.hpp)\n\n\u2022 Material Score: P=100, N=320, B=330, R=500, Q=900, K=20000\n\u2022 Piece-Square Tables (PST): Positional bonuses with vertical rank mirroring for Black\n\u2022 Bishop Pair Bonus: +30 cp for having both bishops\n\u2022 Doubled Pawn Penalty: -20 cp per stacked pawn on same file\n\u2022 Bitboard Acceleration: pop_lsb() iterates occupied squares in O(pieces) time\n\u2022 evaluate_detailed(): 8x8 Influence Heatmap (+0.6 White, -0.6 Black, +0.1 Contested)\n  + Threatened/Hanging Pieces Detection",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 13,
      "containerId": "304318a8-ad9c-441a-b9cd-663a63fe490c",
      "originalText": "EVALUATION ENGINE (evaluation.cpp / evaluation.hpp)\n\n\u2022 Material Score: P=100, N=320, B=330, R=500, Q=900, K=20000\n\u2022 Piece-Square Tables (PST): Positional bonuses with vertical rank mirroring for Black\n\u2022 Bishop Pair Bonus: +30 cp for having both bishops\n\u2022 Doubled Pawn Penalty: -20 cp per stacked pawn on same file\n\u2022 Bitboard Acceleration: pop_lsb() iterates occupied squares in O(pieces) time\n\u2022 evaluate_detailed(): 8x8 Influence Heatmap (+0.6 White, -0.6 Black, +0.1 Contested)\n  + Threatened/Hanging Pieces Detection",
      "lineHeight": 1.3
    },
